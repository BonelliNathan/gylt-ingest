# Copy to .env and fill in — NEVER commit .env or telegram_session/

# From https://my.telegram.org/apps (API development tools)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Session file name (stored in telegram_session/)
TELEGRAM_SESSION_NAME=gylt_capture

# Chat to read: "me" = Saved Messages, or dialog title e.g. SecondBrain, or numeric id
TELEGRAM_CHAT=SecondBrain

# How many recent messages to scan per run (with TELEGRAM_INCREMENTAL=1, only newer than last sync)
TELEGRAM_MESSAGE_LIMIT=20

# Optional: only messages containing this text (e.g. #gylt)
# TELEGRAM_MESSAGE_FILTER=#gylt

# 1 = only messages newer than last successful sync; 0 = always scan last N messages
TELEGRAM_INCREMENTAL=1
